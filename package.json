{
  "name": "vertex-forge",
  "private": true,
  "version": "1.2.0",
  "description": "Vertex Forge - Autonomous AI Software Engineering Studio",
  "author": "Vertex Forge Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rexmoeed/Vertex-Forge",
  "repository": {
    "type": "git",
    "url": "https://github.com/rexmoeed/Vertex-Forge.git"
  },
  "bugs": {
    "url": "https://github.com/rexmoeed/Vertex-Forge/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "eslint src/ --max-warnings=0",
    "test": "vitest run",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:electron-updater",
    "electron": "npm run build:electron && electron .",
    "electron:build": "npm run build && npm run build:electron && electron-builder --win",
    "electron:build:dir": "npm run build && npm run build:electron && electron-builder --win --dir",
    "lint:eslint": "eslint src/ --max-warnings=50",
    "test:coverage": "vitest run --coverage",
    "test:integration-isolated": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "smoke": "node scripts/smoke.cjs"
  },
  "build": {
    "appId": "com.vertexforge.ide",
    "productName": "Vertex Forge",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rexmoeed",
        "repo": "VertexForge"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vertex Forge"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.21",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
