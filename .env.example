# ==============================================================================
# Vertex Forge - Environment Configuration Template
# Copy this file to .env or .env.local to configure your environment
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
DISABLE_HMR=false
# Logging verbosity level (accepted values: debug, info, warn, error)
LOG_LEVEL=info

# Client-Facing Endpoints & Development Server
VITE_API_URL=http://localhost:3000
VITE_DEV_SERVER_URL=http://localhost:5173
APP_URL=http://localhost:3000

# AI Provider Credentials (Optional for local mocking & offline testing)
API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
JULES_API_KEY=your_google_jules_api_key_here

# GitHub Integration Token (Optional: Used for Git operations, commit push, and PR flows)
GITHUB_TOKEN=your_github_personal_access_token_here

# Structured Error Tracking & Observability (Optional)
# Connects unhandled backend/client exceptions to Sentry or custom error tracking provider
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

